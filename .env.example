# Base URL of the TIXX API, called server-side only (SSR fetch in
# app/events/[id] and app/hosts/[id]) — never exposed to the browser, so the
# API's CORS allowlist is irrelevant here.
TIXX_API_BASE_URL=https://api.tixx.im

# Absolute site origin, used for canonical URLs / OG tags / JSON-LD so link
# previews (KakaoTalk, Facebook, etc.) resolve correctly. Leave unset for
# local dev (falls back to relative URLs). Replace with whatever domain this
# site is actually deployed to — not verified/reserved by this change. No
# NEXT_PUBLIC_ prefix — this is server-only, read at runtime, so one Docker
# image can be reused across environments without rebuilding.
SITE_URL=https://tixx.im

# Client ID for the Naver Maps JS SDK v3 (components/detail/NaverMap.tsx),
# used to render an interactive map + marker in the event/host location
# section. Get one from the Naver Cloud Platform console (AI·NAVER API >
# Maps > Web Dynamic Map). Must be NEXT_PUBLIC_-prefixed since it's read in
# the browser to load the SDK <script> tag. When unset (e.g. local dev),
# LocationSection falls back to a keyless OpenStreetMap iframe embed, so
# leaving this blank is safe.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Base URL the browser calls directly when submitting an RSVP form
# (lib/api/rsvp-forms.ts submitRsvpForm) — unlike TIXX_API_BASE_URL, this runs
# client-side with no login/session, so it must be NEXT_PUBLIC_-prefixed to be
# inlined into the browser bundle. The API's CORS allowlist must include this
# site's origin(s) (tixx.im and www.tixx.im) for submissions to succeed.
NEXT_PUBLIC_TIXX_API_BASE_URL=https://api.tixx.im
